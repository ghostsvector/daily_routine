rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /blockedApps/{packageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /activity/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /activitySummaries/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /murthyProtocols/{protocolId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /murthyProgress/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
