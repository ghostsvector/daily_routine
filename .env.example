# Copy to .env and fill in with your Firebase project's values (Firebase
# console → Project settings → General → Your apps), or run
# `flutterfire configure` from this directory to generate them for you and
# skip this file entirely (in that case, point flavors/*/firebase_options.dart
# at the generated values instead of dotenv).
#
# Same keys used by both lib/flavors/external/firebase_options.dart and
# lib/flavors/internal/firebase_options.dart — set FLAVOR=internal (via
# --dart-define=FLAVOR=internal) to point at a second Firebase project for
# an internal/staging build.

FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_BUNDLE_ID=

FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=

FIREBASE_WINDOWS_API_KEY=
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_AUTH_DOMAIN=
FIREBASE_WINDOWS_MEASUREMENT_ID=

FIREBASE_LINUX_API_KEY=
FIREBASE_LINUX_APP_ID=
FIREBASE_LINUX_AUTH_DOMAIN=
FIREBASE_LINUX_MEASUREMENT_ID=
