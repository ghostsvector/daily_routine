#.vscode/

# Local Firebase config — never commit real project credentials.
.env
.env.local
# Auto-generated by `flutterfire configure`/Firebase console; contains a
# real project API key. Was committed by accident (see git history —
# that key must be rotated in Google Cloud Console, since removing the
# file here doesn't invalidate an already-exposed key). Regenerate this
# file locally instead of committing it: flutterfire configure, or
# download from Firebase console → Project settings → your Android app.
/android/app/google-services.json


# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# ./install_deb.sh output — a built artifact, not source. The release
# workflow builds this fresh per tag; a stale committed one previously
# broke the "Rename artifacts" step (dist/*.deb matched two files).
/dist/
pubspec_overrides.yaml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

vscode/